{
    "name": "@r47onfire/nova",
    "private": true,
    "sideEffects": false,
    "version": "0.1.0",
    "description": "A versatile browser-first game engine with tons of cool features",
    "main": "src/index.ts",
    "type": "module",
    "scripts": {
        "build": "bun run scripts/build.ts",
        "build:website": "bun run --sequential clean-dist clean-docs prepare && bun run scripts/build-website.ts",
        "dev": "bun run --parallel \"dev:*\"",
        "dev:serve": "python3 -m http.server -d docs",
        "dev:watch": "bun nodemon -e js,json,ts,css,md,html -i docs -w src -w website -w scripts --exec \"bun run build:website\"",
        "test": "bun test",
        "test:watch": "bun test --watch",
        "prepare": "bun run build --minify",
        "clean-dist": "rm -rf dist/*",
        "clean-docs": "rm -rf docs/*"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/r47onfire/nova.git"
    },
    "keywords": [],
    "author": "",
    "license": "AGPL-3.0-only",
    "devDependencies": {
        "@types/bun": "^1.3.13",
        "@types/node": "^25.6.0",
        "bun-plugin-glsl": "^0.2.2",
        "nodemon": "^3.1.14"
    },
    "dependencies": {
        "@r47onfire/game-math": "github:r47onfire/game-math",
        "lib0": "^0.2.117"
    }
}